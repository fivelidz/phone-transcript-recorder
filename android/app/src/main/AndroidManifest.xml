<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading the native call-recorder output folder + writing audio copies -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Broad media access so we can watch /sdcard/MIUI/sound_recorder/call_rec -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Fallback in-app recording (speakerphone) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Call-state detection so we know a call started/ended -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Optional: map number -> contact name for the note title -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Long-running transcription work -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Start the watcher service after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Transcriber">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service: watches the call-rec folder + runs whisper transcription. -->
        <service
            android:name=".TranscriberService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <!-- Live microphone recorder (in-person meetings + acoustic call capture).
             exported=true with an intent-filter so qalarc-notes can start it directly
             via NotesBridge.launchTranscriber() from the 💬 Transcript view. -->
        <service
            android:name=".RecorderService"
            android:exported="true"
            android:foregroundServiceType="microphone">
            <intent-filter>
                <action android:name="com.fivelidz.transcriber.REC_START" />
                <action android:name="com.fivelidz.transcriber.REC_STOP" />
            </intent-filter>
        </service>

        <!-- Restart the watcher on boot if auto-watch is enabled. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
